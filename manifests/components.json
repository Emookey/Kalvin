      "owner": "SELECTED_PROVIDER",
      "purpose": "Represent a temporary, explicitly approved, authenticated public test boundary for lab only.",
      "allowed_profiles": ["lab"],
      "default_requirement_by_profile": {"lab": "OPTIONAL", "core": "FORBIDDEN", "storage": "FORBIDDEN"},
      "version": {"source": "IMPLEMENTATION_LOCK", "repository_id": null, "immutable_resolution": true},
      "dependencies": [

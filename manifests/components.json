      "state_requirements": [
        {"id": "public-test-configuration", "class": "CONFIGURATION", "path": "/etc/kalvin/public-test-exposure", "backup": "EXCLUDED", "owner": "KALVIN"},
        {"id": "public-test-secrets", "class": "SECRET", "path": "/etc/kalvin/secrets/public-test-exposure", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"},
        {"id": "public-test-runtime", "class": "EPHEMERAL", "path": "/run/kalvin/public-test-exposure", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"},
        {"id": "public-test-logs", "class": "LOG", "path": "/var/log/kalvin/public-test-exposure", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"}

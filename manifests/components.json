      "allowed_profiles": ["lab", "core"],
      "default_requirement_by_profile": {"lab": "OPTIONAL", "core": "OPTIONAL", "storage": "FORBIDDEN"},
      "version": {"source": "IMPLEMENTATION_LOCK", "repository_id": null, "immutable_resolution": true},
      "dependencies": [
        {"component": "model-runtime", "kind": "STARTUP", "required": true, "partial_operation": "The compatibility component remains stopped when its selected runtime is unavailable."}
      ],
      "exposure": {"default": "HOST_INTERNAL", "allowed": ["PROCESS_LOCAL", "HOST_INTERNAL", "PLATFORM_INTERNAL", "LAN", "OVERLAY"]},
      "privilege_class": "UNPRIVILEGED_APPLICATION",
      "state_requirements": [
        {"id": "legacy-ui-configuration", "class": "CONFIGURATION", "path": "/etc/kalvin/open-webui", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"},
        {"id": "legacy-ui-secrets", "class": "SECRET", "path": "/etc/kalvin/secrets/open-webui", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"},
        {"id": "legacy-ui-runtime", "class": "EPHEMERAL", "path": "/run/kalvin/open-webui", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"},
        {"id": "legacy-ui-logs", "class": "LOG", "path": "/var/log/kalvin/open-webui", "backup": "EXCLUDED", "owner": "SELECTED_PROVIDER"}
      ],
      "health_readiness_class": "OPTIONAL_INTEGRATION_READINESS",
      "health_gate": "legacy-open-webui-compatibility.health",
      "readiness_gates": [],
      "compatibility": {"status": "LEGACY", "retirement_gate": "All approved consumers use canonical Kal interfaces and regression evidence no longer requires the bridge."}
    },
    {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-requirements.schema.json",
  "title": "Kalvin profile host-capability requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "requirements"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "observation_path", "comparison", "expected", "profiles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
          "description": {"type": "string", "minLength": 1},
          "observation_path": {
            "enum": [
              "operating_system.family",
              "operating_system.architecture",
              "cpu.logical_cpu_count",
              "memory.total_bytes",
              "block_storage.status",
              "block_storage.devices",
              "filesystems.status",
              "systemd.available",
              "executables.git.present",
              "runtimes.python.version",
              "docker.cli.present",
              "network.default_route.present"
            ]
          },
          "comparison": {"enum": ["EQUALS", "VERSION_AT_LEAST", "NOT_YET_SPECIFIED"]},
          "expected": {"type": ["string", "boolean", "number", "null"]},
          "profiles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lab", "core", "storage"],
            "properties": {
              "lab": {"enum": ["REQUIRED", "OPTIONAL", "NOT_YET_SPECIFIED", "NOT_APPLICABLE"]},
              "core": {"enum": ["REQUIRED", "OPTIONAL", "NOT_YET_SPECIFIED", "NOT_APPLICABLE"]},
              "storage": {"enum": ["REQUIRED", "OPTIONAL", "NOT_YET_SPECIFIED", "NOT_APPLICABLE"]}
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-catalog.schema.json",
  "title": "Kalvin reference component catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "purpose", "allowed_profiles", "default_requirement_by_profile", "version", "dependencies", "exposure", "privilege_class", "state_requirements", "health_readiness_class", "health_gate", "readiness_gates", "compatibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "owner": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "allowed_profiles": {"type": "array", "minItems": 1, "items": {"enum": ["lab", "core", "storage"]}},
          "default_requirement_by_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lab", "core", "storage"],
            "properties": {
              "lab": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]},
              "core": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]},
              "storage": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]}
            }
          },
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "repository_id", "immutable_resolution"],
            "properties": {
              "source": {"enum": ["REPOSITORY_LOCK", "IMPLEMENTATION_LOCK"]},
              "repository_id": {"type": ["string", "null"]},
              "immutable_resolution": {"const": true}
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "kind", "required", "partial_operation"],
              "properties": {
                "component": {"type": "string"},
                "kind": {"enum": ["STARTUP", "HEALTH", "READINESS", "OPTIONAL_INTEGRATION"]},
                "required": {"type": "boolean"},
                "partial_operation": {"type": "string", "minLength": 1}
              }
            }
          },
          "exposure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default", "allowed"],
            "properties": {
              "default": {"enum": ["PROCESS_LOCAL", "HOST_INTERNAL", "PLATFORM_INTERNAL", "LAN", "OVERLAY", "PUBLIC"]},
              "allowed": {"type": "array", "minItems": 1, "items": {"enum": ["PROCESS_LOCAL", "HOST_INTERNAL", "PLATFORM_INTERNAL", "LAN", "OVERLAY", "PUBLIC"]}}
            }
          },
          "privilege_class": {"enum": ["UNPRIVILEGED_APPLICATION", "LIMITED_PLATFORM_SERVICE", "HOST_ADMINISTRATIVE", "EXTERNAL_HOST_MANAGEMENT"]},
          "state_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "class", "path", "backup", "owner"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "class": {"enum": ["AUTHORITATIVE", "DERIVED", "EPHEMERAL", "CONFIGURATION", "SECRET", "LOG"]},
                "path": {"type": "string", "pattern": "^/(opt|etc|var|run|srv)/kalvin(?:/|$)"},
                "backup": {"enum": ["REQUIRED", "REBUILDABLE", "EXCLUDED"]},
                "owner": {"type": "string", "minLength": 1}
              }
            }
          },
          "health_readiness_class": {"enum": ["SELF_HEALTH", "APPLICATION_READINESS", "PLATFORM_READINESS", "STORAGE_READINESS", "OPTIONAL_INTEGRATION_READINESS"]},
          "health_gate": {"type": "string"},
          "readiness_gates": {"type": "array", "items": {"type": "string"}},
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "retirement_gate"],
            "properties": {
              "status": {"enum": ["CANONICAL", "OPTIONAL", "EXPERIMENTAL", "LEGACY"]},
              "retirement_gate": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}

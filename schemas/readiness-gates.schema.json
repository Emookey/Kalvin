{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readiness-gates.schema.json",
  "title": "Kalvin readiness gate catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "gates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "class", "external_application_gate", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "owner": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "external_application_gate": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

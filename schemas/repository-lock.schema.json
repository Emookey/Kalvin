{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-lock.schema.json",
  "title": "Kalvin secret-free immutable repository and implementation lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "locks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repository_id", "desired_ref", "resolved_commit"],
            "properties": {
              "kind": {"const": "REPOSITORY"},
              "repository_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "desired_ref": {"type": "string", "minLength": 1},
              "resolved_commit": {"type": "string"},
              "source_identity": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "component_id", "desired_ref", "resolved_version"],
            "properties": {
              "kind": {"const": "IMPLEMENTATION"},
              "component_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "desired_ref": {"type": "string", "minLength": 1},
              "resolved_version": {"type": "string", "minLength": 1},
              "source_identity": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
            }
          }
        ]
      }
    }
  }
}

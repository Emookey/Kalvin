{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vocabularies.schema.json",
  "title": "Kalvin architecture vocabulary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "state_classes", "backup_classes", "exposure_classes", "privilege_classes", "dependency_kinds", "profile_requirements", "readiness_classes", "compatibility_statuses"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "state_classes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backup_expectation", "restore_expectation", "rebuild_behavior", "acceptable_data_loss", "ownership", "examples"],
        "properties": {
          "id": {"type": "string"},
          "backup_expectation": {"enum": ["REQUIRED", "REBUILDABLE", "EXCLUDED"]},
          "restore_expectation": {"type": "string", "minLength": 1},
          "rebuild_behavior": {"type": "string", "minLength": 1},
          "acceptable_data_loss": {"type": "string", "minLength": 1},
          "ownership": {"type": "string", "minLength": 1},
          "examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "backup_classes": {"type": "array", "items": {"type": "string"}},
    "exposure_classes": {"type": "array", "items": {"type": "string"}},
    "privilege_classes": {"type": "array", "items": {"type": "string"}},
    "dependency_kinds": {"type": "array", "items": {"type": "string"}},
    "profile_requirements": {"type": "array", "items": {"type": "string"}},
    "readiness_classes": {"type": "array", "items": {"type": "string"}},
    "compatibility_statuses": {"type": "array", "items": {"type": "string"}}
  }
}

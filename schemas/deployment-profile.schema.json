{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-profile.schema.json",
  "title": "Kalvin non-operational deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "id", "role", "production_mode", "purpose", "components", "required_readiness_gates", "default_exposure_ceiling", "exposure_exceptions", "backup_posture", "repository_policy", "compatibility_policy", "profile_invariants"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "id": {"enum": ["lab", "core", "storage"]},
    "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "production_mode": {"type": "boolean"},
    "purpose": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "default_enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "requirement": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]},
          "default_enabled": {"type": "boolean"}
        }
      }
    },
    "required_readiness_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "default_exposure_ceiling": {"enum": ["PROCESS_LOCAL", "HOST_INTERNAL", "PLATFORM_INTERNAL", "LAN", "OVERLAY", "PUBLIC"]},
    "exposure_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "maximum", "default_enabled", "requires_gates"],
        "properties": {
          "component": {"type": "string"},
          "maximum": {"enum": ["PROCESS_LOCAL", "HOST_INTERNAL", "PLATFORM_INTERNAL", "LAN", "OVERLAY", "PUBLIC"]},
          "default_enabled": {"const": false},
          "requires_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "backup_posture": {"enum": ["NO_PRODUCTION_GUARANTEE", "OUTBOUND_AUTHORITATIVE_BACKUP_REQUIRED", "RETENTION_AND_RESTORE_SOURCE_AUTHORITY"]},
    "repository_policy": {"enum": ["DEVELOPMENT_REFS_ALLOWED_BUT_IMMUTABLE_RESOLUTION_REQUIRED", "REVIEWED_REF_AND_IMMUTABLE_RESOLUTION_REQUIRED"]},
    "compatibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_by_default", "implicit_fallback", "allowed_statuses"],
      "properties": {
        "enabled_by_default": {"const": false},
        "implicit_fallback": {"const": false},
        "allowed_statuses": {"type": "array", "items": {"enum": ["CANONICAL", "OPTIONAL", "EXPERIMENTAL", "LEGACY"]}}
      }
    },
    "profile_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

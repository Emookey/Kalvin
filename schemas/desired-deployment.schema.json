{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desired-deployment.schema.json",
  "title": "Kalvin desired deployment manifest contract",
  "description": "Schema only; Phase 4C provides no deployer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "repositories", "component_selections", "host_configuration_ref", "secret_references", "compatibility_entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "profile_id": {"enum": ["lab", "core", "storage"]},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "desired_ref"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "desired_ref": {"type": "string", "minLength": 1},
          "commit_constraint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "component_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "desired_version"],
        "properties": {
          "id": {"type": "string"},
          "enabled": {"type": "boolean"},
          "desired_version": {"type": ["string", "null"]}
        }
      }
    },
    "host_configuration_ref": {"type": "string", "pattern": "^host-config-ref://[a-z0-9][a-z0-9._/-]+$"},
    "secret_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "consumer", "ref"],
        "properties": {
          "id": {"type": "string"},
          "consumer": {"type": "string"},
          "ref": {"type": "string", "pattern": "^secret-ref://[a-z0-9][a-z0-9._/-]+$"}
        }
      }
    },
    "compatibility_entries": {"type": "array", "items": {"type": "string"}}
  }
}

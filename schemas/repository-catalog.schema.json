{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-catalog.schema.json",
  "title": "Kalvin independent repository catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_status", "operational", "source_binding", "repositories"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "contract_status": {"const": "reference-architecture"},
    "operational": {"const": false},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "purpose", "credentials_in_manifest", "correctness_anchor"],
      "properties": {
        "policy": {"const": "HOST_CONFIGURED_MIRROR"},
        "purpose": {"type": "string"},
        "credentials_in_manifest": {"const": false},
        "correctness_anchor": {"const": "VERIFIED_FULL_COMMIT"}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "purpose", "submodule", "vendored", "desired_ref_required", "resolved_full_commit_required", "profile_ref_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "owner": {"type": "string"},
          "purpose": {"type": "string"},
          "submodule": {"const": false},
          "vendored": {"const": false},
          "desired_ref_required": {"const": true},
          "resolved_full_commit_required": {"const": true},
          "profile_ref_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lab", "core", "storage"],
            "properties": {
              "lab": {"enum": ["DEVELOPMENT_ALLOWED", "REVIEWED_RELEASE_OR_STABLE_REF", "NOT_SELECTED"]},
              "core": {"enum": ["DEVELOPMENT_ALLOWED", "REVIEWED_RELEASE_OR_STABLE_REF", "NOT_SELECTED"]},
              "storage": {"enum": ["DEVELOPMENT_ALLOWED", "REVIEWED_RELEASE_OR_STABLE_REF", "NOT_SELECTED"]}
            }
          }
        }
      }
    }
  }
}

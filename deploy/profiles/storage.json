{
  "$schema": "../../schemas/deployment-profile.schema.json",
  "schema_version": "1.0.0",
  "contract_status": "reference-architecture",
  "operational": false,
  "id": "storage",
  "role": "BACKUP_NAS_RETENTION",
  "production_mode": true,
  "purpose": "Backup repository, retention, NAS/storage, and explicitly authorized restore-source functions.",
  "components": [
    {"id": "kal", "requirement": "FORBIDDEN", "default_enabled": false},
    {"id": "beepy", "requirement": "FORBIDDEN", "default_enabled": false},
    {"id": "model-runtime", "requirement": "FORBIDDEN", "default_enabled": false},
    {"id": "monitoring", "requirement": "REQUIRED", "default_enabled": true},
    {"id": "backup-client", "requirement": "OPTIONAL", "default_enabled": false},
    {"id": "storage-backup-target", "requirement": "REQUIRED", "default_enabled": true},
    {"id": "network-overlay", "requirement": "OPTIONAL", "default_enabled": false},
    {"id": "legacy-open-webui-compatibility", "requirement": "FORBIDDEN", "default_enabled": false},
    {"id": "public-test-exposure", "requirement": "FORBIDDEN", "default_enabled": false}
  ],
  "required_readiness_gates": [
    "platform.contracts-valid",
    "repositories.resolved",
    "configuration.complete",
    "secrets.resolved",
    "selected-components.ready",
    "storage.repository-ready",
    "storage.retention-ready",
    "storage.restore-authorization-ready",
    "identity.separation-validated",
    "exposure.policy-valid",
    "monitoring.health",
    "storage-backup-target.health"
  ],
  "default_exposure_ceiling": "OVERLAY",
  "exposure_exceptions": [],
  "backup_posture": "RETENTION_AND_RESTORE_SOURCE_AUTHORITY",
  "repository_policy": "REVIEWED_REF_AND_IMMUTABLE_RESOLUTION_REQUIRED",
  "compatibility_policy": {"enabled_by_default": false, "implicit_fallback": false, "allowed_statuses": ["OPTIONAL"]},
  "profile_invariants": [
    "Storage does not run Kal, Beepy, or model compute by default.",
    "Backup submission, restore authorization, and application administration use separate identities.",
    "Retention belongs to Storage and backup payloads are never mounted as live application state."
  ]
}
